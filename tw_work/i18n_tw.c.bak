#define TW_CHAR_N (int)(sizeof(s_tw_char) / sizeof(s_tw_char[0]))

static unsigned short tw_char_map(unsigned short cp)
{
    int lo = 0, hi = TW_CHAR_N - 1;
    while (lo <= hi) {
        int mid = (lo + hi) >> 1;
        if (s_tw_char[mid][0] == cp) return s_tw_char[mid][1];
        if (s_tw_char[mid][0] < cp) lo = mid + 1; else hi = mid - 1;
    }
    return 0;
}

/* 环形输出缓冲: 兼容一次 snprintf 内多个 tr()/tr_tw() 结果同时存活 */
static char s_tw_buf[4][512];
static int  s_tw_buf_idx = 0;

void tw_convert_into(char *dst, int dst_len, const char *src)
{
    int o = 0;
    if (!dst || dst_len <= 0) return;
    if (!src) { dst[0] = '\0'; return; }
    while (*src && o < dst_len - 1) {
        unsigned char b0 = (unsigned char)src[0];
        if (b0 < 0x80) { dst[o++] = *src++; continue; }
        int matched = 0;
        {
            const unsigned short rng[2] = { s_tw_widx[b0 - 0x80][0], s_tw_widx[b0 - 0x80][1] };
            for (unsigned short i = rng[0]; i < rng[1]; i++) {
                if (strncmp(src, s_tw_words[i].zh, s_tw_words[i].len) == 0) {
                    const char *t = s_tw_words[i].tw;
                    int tl = 0; while (t[tl]) tl++;
                    if (o + tl < dst_len) {
                        memcpy(dst + o, t, (size_t)tl);
                        o += tl; src += s_tw_words[i].len; matched = 1;
                    }
                    break;
                }
            }
        }
        if (matched) continue;
        int cl = (b0 & 0xE0) == 0xC0 ? 2 : (b0 & 0xF0) == 0xE0 ? 3 : (b0 & 0xF8) == 0xF0 ? 4 : 1;
        if (cl == 3 && (b0 & 0xF0) == 0xE0 && o + 3 < dst_len &&
            (unsigned char)src[1] >= 0x80 && (unsigned char)src[2] >= 0x80) {
            unsigned short cp = (unsigned short)(((b0 & 0x0F) << 12) |
                             (((unsigned char)src[1] & 0x3F) << 6) | ((unsigned char)src[2] & 0x3F));
            unsigned short mp = (cp >= 0x3400 && cp <= 0x9FFF) ? tw_char_map(cp) : 0;
            if (mp) {
                dst[o++] = (char)(0xE0 | (mp >> 12));
                dst[o++] = (char)(0x80 | ((mp >> 6) & 0x3F));
                dst[o++] = (char)(0x80 | (mp & 0x3F));
                src += 3;
                continue;
            }
        }
        for (int k = 0; k < cl && o < dst_len - 1; k++) dst[o++] = src[k];
        src += cl;
    }
    dst[o] = '\0';
}

const char *tr_tw(const char *zh)
{
    char *b = s_tw_buf[s_tw_buf_idx];
    s_tw_buf_idx = (s_tw_buf_idx + 1) & 3;
    tw_convert_into(b, (int)sizeof(s_tw_buf[0]), zh ? zh : "");
    return b;
}
